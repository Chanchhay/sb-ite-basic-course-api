# Deployed to /opt/apps/ipos/.env — copy this file there and fill in the blanks.

# --- Database (db service reads these too) ---
PGDATABASE=fluxibix
DB_USER=
DB_PASS=

# --- Keycloak ---
ISSUER_URI=
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
TARGET_REALM=

# --- MinIO ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- App ---
SERVER_URL=https://api.fluxibiz.store
BASE_STOREFRONT_DOMAIN=fluxibiz.store
CREDENTIAL_ENCRYPTION_KEY=

# --- Optional integrations ---
TELEGRAM_WEBHOOK_BASE_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=
FACEBOOK_FRONTEND_RESULT_URL=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# Set by the Jenkins Deploy stage to the deployed commit SHA.
IMAGE_TAG=latest

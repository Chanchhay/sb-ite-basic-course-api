    {
      "name": "platform-admin-policy",
      "description": "Allows users with the PLATFORM_ADMIN client role.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "AFFIRMATIVE",
      "config": {
        "fetchRoles": "false",
        "roles": "[]"
      }
    },
